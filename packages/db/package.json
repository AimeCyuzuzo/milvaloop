{
  "name": "@milvaloop/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@milvaloop/eslint-config": "workspace:*",
    "eslint": "^9.39.1",
    "@milvaloop/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "5.9.2"
  }
}

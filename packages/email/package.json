{
  "name": "@milvaloop/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "email:dev": "email dev --dir src/templates"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "nodemailer": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@milvaloop/eslint-config": "workspace:*",
    "@milvaloop/typescript-config": "workspace:*",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "react-email": "^6.9.2",
    "typescript": "5.9.2"
  }
}

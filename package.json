{
  "name": "milvaloop",
  "private": true,
  "scripts": {
    "build": "dotenv -e .env -- turbo run build",
    "dev": "dotenv -e .env -- turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "docker:dev": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "pnpm --filter @milvaloop/db db:generate",
    "db:migrate": "pnpm --filter @milvaloop/db db:migrate"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  }
}

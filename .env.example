# Single source of truth for local dev env vars, loaded once at the repo
# root and inherited by every app/service process (see package.json
# "dev"/"build" scripts). Copy to .env and fill in as needed.
#
# NODE_ENV is deliberately not set here — it must be inferred by whichever
# command is running (next dev -> development, next build/start ->
# production), not fixed by a shared env file. Setting it here breaks
# production builds by forcing them into development mode.

# --- services/main ---------------------------------------------------------
PORT=5331

# Only read by docker-compose.prod.yml, to bootstrap the Postgres
# container with real credentials — local dev's docker-compose.yml
# hardcodes these same values directly instead. Must match the
# credentials embedded in DATABASE_URL below.
POSTGRES_USER=milvaloop
POSTGRES_PASSWORD=milvaloop
POSTGRES_DB=milvaloop

DATABASE_URL=postgres://milvaloop:milvaloop@localhost:5333/milvaloop

REDIS_URL=redis://localhost:5335

MINIO_ENDPOINT=localhost
MINIO_PORT=5334
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=milvaloop
MINIO_SECRET_KEY=milvaloop-dev
MINIO_BUCKET=milvaloop

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="MilvaLoop <no-reply@milvaloop.local>"
# Mailpit takes no auth at all — leave both unset locally. A real provider
# needs both (e.g. Resend: SMTP_USER=resend, SMTP_PASSWORD=<API key>) and
# SMTP_SECURE=true only for a provider that wants implicit TLS (port 465)
# rather than STARTTLS (587, the more common default).
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

JWT_ACCESS_SECRET=change-me-in-development-min-32-chars
JWT_REFRESH_SECRET=change-me-in-development-min-32-chars
AUTH_TICKET_SECRET=change-me-in-development-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

COOKIE_DOMAIN=localhost
WEB_ORIGIN=http://localhost:5330

# --- apps/web ---------------------------------------------------------------
WEB_PORT=5330
NEXT_PUBLIC_API_URL=http://localhost:5331
# development | preview | production — only "production" is crawlable/indexed
NEXT_PUBLIC_SITE_ENV=development

{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "REDIS_URL",
    "MINIO_ENDPOINT",
    "MINIO_PORT",
    "MINIO_USE_SSL",
    "MINIO_ACCESS_KEY",
    "MINIO_SECRET_KEY",
    "MINIO_BUCKET",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_FROM",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "AUTH_TICKET_SECRET",
    "JWT_ACCESS_TTL",
    "JWT_REFRESH_TTL",
    "COOKIE_DOMAIN",
    "WEB_ORIGIN",
    "WEB_PORT",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SITE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
